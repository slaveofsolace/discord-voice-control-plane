{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "discord-vc-cloudflare-voice-probe",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "containers": [
    {
      "class_name": "VoiceProbeContainer",
      "image": "../../Dockerfile.cloudflare-voice-probe",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VOICE_PROBE_CONTAINER", "class_name": "VoiceProbeContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceProbeContainer"] }]
}
