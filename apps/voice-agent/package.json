    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@discord-vc-control/agent-client": "workspace:*",
    "@discord-vc-control/config": "workspace:*",
    "@discord-vc-control/contracts": "workspace:*",
    "@discord-vc-control/security": "workspace:*",
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
